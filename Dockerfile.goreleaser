# Minimal image used by GoReleaser at release time. Unlike the top-level
# Dockerfile (which builds from source for `docker build .` / docker-compose),
# this one copies the already-built static binary GoReleaser places in the
# build context — same FROM-scratch result, no in-image compile.
FROM scratch

COPY netherchat-server /netherchat-server

USER 65534:65534
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=3s --start-period=2s --retries=3 \
    CMD ["/netherchat-server", "--healthcheck"]
ENTRYPOINT ["/netherchat-server"]
CMD ["--addr", ":3000"]
