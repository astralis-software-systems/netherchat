# netherchat-itsm config for ServiceNow (NC-4). Copy to netherchat-itsm.toml.
# Flags override these values. On /seal, the signed record is attached to the
# incident and a metadata work note is added — pointer + attestation only.
room       = "ops"
server     = "ws://localhost:3000"
name       = "itsm-bridge"
itsm       = "servicenow"
itsm_url   = "https://instance.service-now.com"
itsm_user  = "admin"
itsm_token = "REPLACE_ME"          # password or API token
ticket     = "INC0010001"          # sys_id or number of the incident
# identity = "./itsm-identity.json"
# invite   = "REPLACE_ME"          # one-time token, if the room is invite-only
