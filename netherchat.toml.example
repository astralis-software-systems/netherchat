# netherchat.toml — Netherchat server configuration (config-as-code).
# Copy to netherchat.toml and run:  netherchat-server --config netherchat.toml
# Every field is optional; the defaults below are what the server uses with no
# config at all.

[server]
addr = ":3000"
# For wss:// you usually terminate TLS at a reverse proxy. To serve TLS directly,
# set both of these (PEM files):
# tls_cert = "/etc/netherchat/cert.pem"
# tls_key  = "/etc/netherchat/key.pem"

[limits]
# Per-connection inbound message rate limit (token bucket).
messages_per_second = 20
burst = 40
# Ephemeral artifact relay (§2.3) — a secure transfer courier, never storage.
# max_file_bytes is a CLIENT-evaluated policy: a blind relay cannot see a
# transfer's size (it is sealed), so the sender refuses larger artifacts at offer
# time and the receiver aborts if its in-memory buffer would exceed it.
max_file_bytes = 52428800          # 50 MiB per artifact
# max_concurrent_transfers IS relay-enforced (the relay sees the content-free
# transfer ids): new offers are rejected once a room hits this many in flight.
max_concurrent_transfers = 3

[persistence]
# Off by default — the server is purely in-memory and rooms evaporate when empty.
# When enabled, ONLY ciphertext is stored (the server still cannot read it), in a
# local SQLite file. Never cloud.
enabled = false
# path = "netherchat.db"
# history = 100          # messages replayed to a client when it joins
# Each row is additionally encrypted AT REST with AES-256-GCM under a key derived
# (HKDF-SHA256, "netherchat/sqlite/v1") from a server secret, so a stolen disk
# yields ciphertext only. Prefer supplying the secret OUT OF BAND via the
# NETHERCHAT_PERSIST_KEY environment variable — that is the only source that also
# protects against theft of the database file itself. You MAY instead set it here
# (committed alongside config, so weaker), or omit both and the server generates a
# sidecar <path>.key (0600) automatically. See docs/encryption.md.
# key = "a-long-random-operator-secret"

# --- Privileged-action quorum (Two-Person Rule, §1.3) ------------------------
# How many DISTINCT authorized members must endorse the same request before a
# privileged action fires. The initiator's signed request is endorser #1, so
# quorum = 2 is the classic two-person rule: a single actor cannot proceed — a
# second authorized member must independently approve before the action executes.
#   quorum = 1  → single actor (the default, today's behavior)
#   quorum = 2  → the requester plus one independent approver
#   quorum = 0  → the action is disabled entirely
#
# Enforcement is CLIENT-SIDE and cryptographic (N-of-M Ed25519 over the request
# hash); the relay routes the request/approval/veto frames as opaque ciphertext and
# cannot bypass the gate. This is a CLIENT-evaluated policy (like [[trust]]): the
# connecting client (for /scuttle and /break-glass) and the edge agent (for runbook
# execution) read it here. Run `netherchat agent --config netherchat.toml` so the
# agent picks up [action.runbook].
[action.runbook]
quorum = 2                 # require a second authorized co-signer before any runbook action runs
[action.scuttle]
quorum = 2                 # /scuttle now and /scuttle arm require a second approver
# [action.break_glass]
# quorum = 3               # opening a war room requires three endorsers (requester + 2)

# NOTE: there is deliberately no server-side [exec]. A blind relay must never run
# commands. /exec is an EDGE feature: it sends a signed, E2E-encrypted request the
# relay only routes as ciphertext, and a `netherchat agent` on your OWN host runs
# it against its own runbook allowlist. See runbook.toml.example.

# --- Rooms -------------------------------------------------------------------
# Rooms are created on demand with open defaults. Define a room here only to set
# policy. The table key is the room name.

[rooms.general]
# defaults: open, no webhook, no ttl

[rooms.ops]
invite_only = true        # joining requires a one-time invite token (/invite)
# Status Beacon (§1.2): out-of-band, read-only incident status for stakeholders who
# must NOT be in the war room. /beacon set publishes a status line encrypted to a
# SEPARATE key (HKDF of the room secret); the relay stores one ciphertext blob it
# cannot read, the single opt-in, TTL'd exception to zero-persistence. A room can
# have a beacon only if beacon_token (or webhook_token) is set.
beacon_token = "change-me-to-a-long-random-secret"  # authorizes PUT/DELETE /beacon/ops
beacon_ttl   = "1h"                                 # how long a beacon persists (hard max 24h)

[rooms.alerts]
webhook = true            # accept POST /webhook/alerts
webhook_token = "change-me-to-a-long-random-secret"  # required in X-Netherchat-Token
ttl = "24h"               # ephemeral: the room is cleared after this much inactivity

# --- Dead-man's switch / auto-scuttle (§1.6) ---------------------------------
# A scuttle is stronger than ttl: when it fires it first tells every client to
# ratchet its room key forward (forward secrecy) and renders a signed-in-spirit
# attestation that the room scuttled — then closes the room. The default failure
# mode becomes "the evidence destroys itself", not "someone forgot to delete it".
[rooms.warroom.scuttle]
idle_after      = "30m"    # no activity (any message/join/leave/ack/record) for this long → scuttle
owner_loss_burn = true     # if the first joiner disconnects while others remain → scuttle
heartbeat       = "60s"    # how often the idle janitor checks (default 60s; capped at idle_after)
# Manual controls are always available in the TUI, regardless of policy:
#   /scuttle now        burn the room immediately
#   /scuttle arm 10m    show a visible countdown to everyone, then auto-burn

# --- Trust (CLIENT-SIDE ONLY) ------------------------------------------------
# [[trust]] entries are read by CLIENTS for /whois identity pinning. The relay
# never reads them and never participates in any trust decision. Both fields are
# independently optional: fpr-only pins a fingerprint (warns on mismatch);
# keys_url-only fetches published keys on /whois (never auto-pins); both does
# both; neither is just a display-name alias.

[[trust]]
handle   = "alice"
fpr      = "SHA256:Hk3xyzABCDEF..."          # from: ssh-keygen -lf ~/.ssh/id_ed25519
keys_url = "https://github.com/alice.keys"   # canonical published-key source

[[trust]]
handle   = "oncall-2"
keys_url = "https://github.com/oncall-2.keys"  # fetch on /whois; no pin

# --- Sneakernet Mode (CLIENT-SIDE, §1.1) -------------------------------------
# Defaults for `netherchat pair`, the relay-LESS peer-to-peer war room. Like
# [[trust]], the relay never reads these — relay-less pairing involves no server.
[direct]
port          = 7777   # listening port for direct peer connections (0 = a free port)
lan_discovery = true    # advertise + discover on the LAN via mDNS (_netherchat._tcp)
# Sneakernet has NO NAT traversal by design: peers must share a LAN (--lan) or be
# directly reachable by the addresses in a manual offer (--manual), e.g. over a VPN.

# --- Desktop notifications (CLIENT-SIDE, §2.1) -------------------------------
# Native OS notifications (notify-send / osascript / BurntToast), zero push
# infrastructure — all client-side, falling back to the terminal bell. Read only
# by the TUI. Valid events: mention, decision, ack, break_glass.
[notify]
on = ["mention", "decision", "break_glass"]
# mention     = someone used your display name in a message
# decision    = a /decide was recorded
# ack         = a coordination /ack was counted
# break_glass = a war room was created

# --- Slash-command macros (CLIENT-SIDE, §2.5) --------------------------------
# Team-specific shortcuts, expanded by the TUI's slash engine before dispatch.
# Chain multiple commands with · (middle dot). A macro name must not collide with
# a built-in command, and circular expansion is rejected at startup. Macros show
# up in Tab autocomplete alongside built-ins. Read only by the TUI.
[macros]
sev1     = "/break-glass --invite oncall,ic --ttl 4h"
sev2     = "/break-glass --invite oncall --ttl 2h"
drain    = "/ack drain-complete"
resolved = "/decide incident resolved · /vanish"
